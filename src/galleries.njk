---
pagination:
  data: galleryData
  size: 1
  alias: gallery
permalink: "{{ gallery.locale }}/{{ gallery.location }}/index.html"
---

{% if gallery.gallery_description %}
<div class="location-intro">
  {% for section in gallery.gallery_description %}
    <h2>{{ section.heading }}</h2>
    <p>{{ section.content | markdownBold | safe }}</p>
  {% endfor %}
</div>
<hr />
{% endif %}

<h2>{% if gallery.locale == 'bg' %}Фотогалерия{% else %}Photo Gallery{% endif %}</h2>

<ul class="gallery gallery--photos" aria-label="{% if gallery.locale == 'bg' %}Снимки от {{ gallery.locationName }}{% else %}Photos from {{ gallery.locationName }}{% endif %}">
{% for photo in gallery.photos %}
  <li>
    <a href="/albums/{{ gallery.location }}/{{ photo.filename }}" data-photo-index="{{ loop.index0 }}" class="gallery-thumbnail" aria-label="{% if gallery.locale == 'bg' %}Отворете снимка: {{ photo.title }}{% else %}Open photo: {{ photo.title }}{% endif %}">
      {% set thumbnailName = photo.filename | replace('.jpg', '.jpg_TN') | replace('.JPG', '.JPG_TN') | replace('.png', '.png_TN') %}
      <img src="/albums/{{ gallery.location }}/{{ thumbnailName }}"
           alt="{% if photo.alt and photo.alt != ' ' %}{{ photo.alt | plainText }}{% else %}{{ photo.title }}{% endif %}"
           loading="lazy"
           decoding="async" />
      <span class="gallery-card__title">{{ photo.title }}</span>
    </a>
  </li>
{% endfor %}
</ul>

<!-- Detailed Photo Descriptions for SEO and Content -->
<div class="photo-descriptions">
  <h2>{% if gallery.locale == 'bg' %}Детайлно описание на снимките{% else %}Detailed Photo Descriptions{% endif %}</h2>
  {% for photo in gallery.photos %}
    <div class="photo-detail" id="photo-{{ loop.index }}">
      <h3>{{ loop.index }}. {{ photo.title }}</h3>
      {% if photo.sections and photo.sections[0] and photo.sections[0].content %}
        <p>{{ photo.sections[0].content | markdownBold | safe }}</p>
      {% endif %}
      {% if photo.alt and photo.alt != ' ' %}
        <p><em>{{ photo.alt }}</em></p>
      {% endif %}
    </div>
  {% endfor %}
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  "name": {{ title | dump | safe }},
  "url": "{{ page.url | absoluteUrl(site.url) }}",
  "inLanguage": "{{ gallery.locale }}",
  "associatedMedia": [
    {% for photo in gallery.photos %}
    {% set thumbnailName = photo.filename | replace('.jpg', '.jpg_TN') | replace('.JPG', '.JPG_TN') | replace('.png', '.png_TN') %}
    {% set photoDescription = '' %}
    {% if photo.sections and photo.sections[0] and photo.sections[0].content %}
      {% set photoDescription = photo.sections[0].content | plainText %}
    {% elif photo.alt and photo.alt != ' ' %}
      {% set photoDescription = photo.alt | plainText %}
    {% endif %}
    {
      "@type": "ImageObject",
      "name": {{ photo.title | dump | safe }},
      "description": {{ photoDescription | dump | safe }},
      "contentUrl": "{{ ('/albums/' + gallery.location + '/' + photo.filename) | absoluteUrl(site.url) }}",
      "thumbnailUrl": "{{ ('/albums/' + gallery.location + '/' + thumbnailName) | absoluteUrl(site.url) }}"
    }{{ "," if not loop.last }}
    {% endfor %}
  ]
}
</script>

<!-- Lightbox Modal -->
<div id="lightbox-modal" class="lightbox-modal" role="dialog" aria-modal="true" aria-labelledby="lightbox-title" hidden>
  <div class="lightbox-content">
    <button class="lightbox-close" type="button" aria-label="{% if gallery.locale == 'bg' %}Затвори{% else %}Close{% endif %}">&times;</button>
    <button class="lightbox-prev" type="button" aria-label="{% if gallery.locale == 'bg' %}Предишна снимка{% else %}Previous photo{% endif %}">&#10094;</button>
    <button class="lightbox-next" type="button" aria-label="{% if gallery.locale == 'bg' %}Следваща снимка{% else %}Next photo{% endif %}">&#10095;</button>

    <div class="lightbox-image-container">
      <img id="lightbox-image" src="" alt="" />
    </div>

    <div class="lightbox-description">
      <h3 id="lightbox-title"></h3>
      <div id="lightbox-text"></div>
    </div>
  </div>
</div>

<script>
// Photo data
const galleryPhotos = [
{% for photo in gallery.photos %}
  {
    filename: "{{ photo.filename }}",
    title: {{ photo.title | dump | safe }},
    alt: {{ photo.alt | dump | safe }},
    description: {% if photo.sections and photo.sections[0] and photo.sections[0].content %}{{ photo.sections[0].content | plainText | dump | safe }}{% else %}""{% endif %}
  }{{ "," if not loop.last }}
{% endfor %}
];

const galleryLocation = "{{ gallery.location }}";
const lightboxModal = document.getElementById('lightbox-modal');
const lightboxImage = document.getElementById('lightbox-image');
const lightboxTitle = document.getElementById('lightbox-title');
const lightboxText = document.getElementById('lightbox-text');
const closeButton = document.querySelector('.lightbox-close');
const previousButton = document.querySelector('.lightbox-prev');
const nextButton = document.querySelector('.lightbox-next');
let currentPhotoIndex = 0;

// Open lightbox
document.querySelectorAll('.gallery-thumbnail').forEach(thumbnail => {
  thumbnail.addEventListener('click', (e) => {
    e.preventDefault();
    currentPhotoIndex = parseInt(e.currentTarget.dataset.photoIndex);
    showPhoto(currentPhotoIndex);
    lightboxModal.hidden = false;
    lightboxModal.classList.add('is-visible');
    document.body.classList.add('no-scroll');
    closeButton?.focus();
  });
});

// Close lightbox
closeButton?.addEventListener('click', closeLightbox);
lightboxModal.addEventListener('click', (e) => {
  if (e.target === lightboxModal) {
    closeLightbox();
  }
});

function closeLightbox() {
  lightboxModal.hidden = true;
  lightboxModal.classList.remove('is-visible');
  document.body.classList.remove('no-scroll');
}

// Navigation
previousButton?.addEventListener('click', (e) => {
  e.stopPropagation();
  currentPhotoIndex = (currentPhotoIndex - 1 + galleryPhotos.length) % galleryPhotos.length;
  showPhoto(currentPhotoIndex);
});

nextButton?.addEventListener('click', (e) => {
  e.stopPropagation();
  currentPhotoIndex = (currentPhotoIndex + 1) % galleryPhotos.length;
  showPhoto(currentPhotoIndex);
});

// Keyboard navigation
document.addEventListener('keydown', (e) => {
  if (!lightboxModal.hidden) {
    if (e.key === 'Escape') {
      closeLightbox();
    } else if (e.key === 'ArrowLeft') {
      previousButton?.click();
    } else if (e.key === 'ArrowRight') {
      nextButton?.click();
    }
  }
});

function showPhoto(index) {
  const photo = galleryPhotos[index];
  lightboxImage.src = `/albums/${galleryLocation}/${photo.filename}`;
  lightboxImage.alt = photo.alt || photo.title;
  lightboxTitle.textContent = photo.title;
  lightboxText.textContent = '';
  const paragraph = document.createElement('p');
  paragraph.textContent = photo.description || photo.alt || '';
  lightboxText.appendChild(paragraph);
}
</script>

<div class="ad-cta">
  <p>
    {% if gallery.locale == 'bg' %}
      📸 <strong>Харесват ли ви снимките?</strong> ✨Научете се да снимате и вие така професионално! 🎓
      <span>Открийте тайните на перфектната фотография</span>
    {% else %}
      📸 <strong>Do you like these photos?</strong> ✨Learn to take photos like this professionally! 🎓<br>
      <span>Discover the secrets of perfect photography</span>
    {% endif %}
  </p>
  <a href="https://greatphotoart.com" target="_blank" rel="noopener" class="ad-cta__button">
    {% if gallery.locale == 'bg' %}
      🎯 Курс по фотография →
    {% else %}
      🎯 Photography Course →
    {% endif %}
  </a>
</div>

